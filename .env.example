# Trello creds are asked once (in the GUI) and saved to ~/.keyword_generator.json.
# You can still override them here if you prefer env vars.
TRELLO_API_KEY=your_trello_api_key
TRELLO_TOKEN=your_trello_token

# Title + tags are generated by the `claude` CLI (Claude Code) — no API key here.
# The CLI must be installed and logged in. Override the model if you like:
CLAUDE_MODEL=claude-sonnet-5
